namespace MuseProjection
def z (i : Fin 112) : ℚ := (33+i.val)/100
def square (i : Fin 112) : ℚ := (1.2307292376441814:ℚ)^2 * ((315/1000:ℚ)*(1+z i)^3+685/1000)
