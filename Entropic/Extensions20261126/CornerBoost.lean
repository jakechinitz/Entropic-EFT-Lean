import Entropic.Extensions20261119.AngularRule
import Mathlib.Tactic

/-!
# The angular rule as the corner boost weight (Appendix Q.11)

In the Lorentzian quantization of vacuum general relativity on null cones
(Chandrasekaran, arXiv:2611.34924, eqs. (5.22), (5.23), (5.39)), real corner boosts are generated by
`𝒜/(8πG)`, and continuing the boost through a full turn gives the corner weight `e^{−𝒜/(4Għ)}`.
This file proves the finite identities used in Q.11, in units with the area measured in `ħG₀/c³ = hG`:

* `channel_boost_eq_rule`: for one channel of area `A_ch = 4 ln 2 · hG`, the boost weight continued to
  a Euclidean angle `θ` is `e^{−θ A_ch/(8π hG)} = e^{−bθ}` with `b = ln 2/(2π)`, at every `θ`;
* `sector_replica_iff`: on an `N`-channel area sector, the replica weight `d · e^{−n A/(4 hG)}` equals the
  product of the per-channel replica traces `(2^{1−n})^N` exactly when the sector has `d = 2^N` states;
* `level_contributes_one`: such a level contributes exactly one to `Tr e^{−𝒜/(4Għ)}`.

Not formalized: the quantization itself (continuum algebras on null cones), and the identification of
the coarse-grained bond vacuum with the corner state.
-/

noncomputable section
namespace Entropic.Extensions20261126.CornerBoost
open Real
open Entropic.Extensions20261119.AngularRule (bFlat)

/-- Area of one channel, in units of `ħG₀/c³ = hG`. -/
def aCh (hG : ℝ) : ℝ := 4 * Real.log 2 * hG

/-- Area of an `N`-channel sector. -/
def areaN (hG : ℝ) (N : ℕ) : ℝ := N * aCh hG

/-- The corner boost weight of one channel, continued to angle `θ`, is the angular rule at every `θ`. -/
theorem channel_boost_eq_rule {hG : ℝ} (hG0 : hG ≠ 0) (θ : ℝ) :
    Real.exp (-(θ * aCh hG) / (8 * π * hG)) = Real.exp (-bFlat * θ) := by
  have hπ : π ≠ 0 := Real.pi_ne_zero
  congr 1; unfold aCh bFlat; field_simp; ring

/-- At the full turn the channel weight is `1/2`, the flat one-channel density. -/
theorem channel_full_turn {hG : ℝ} (hG0 : hG ≠ 0) :
    Real.exp (-(2 * π * aCh hG) / (8 * π * hG)) = 1 / 2 := by
  have hπ : π ≠ 0 := Real.pi_ne_zero
  rw [show -(2 * π * aCh hG) / (8 * π * hG) = -Real.log 2 by unfold aCh; field_simp; ring,
    Real.exp_neg, Real.exp_log (by norm_num)]; norm_num

theorem full_turn_weight {hG : ℝ} (hG0 : hG ≠ 0) (N : ℕ) (n : ℝ) :
    Real.exp (-n * areaN hG N / (4 * hG)) = Real.exp (-n * N * Real.log 2) := by
  congr 1; unfold areaN aCh; field_simp

theorem two_pow_eq_exp (N : ℕ) : (2 : ℝ) ^ N = Real.exp (N * Real.log 2) := by
  rw [Real.exp_nat_mul, Real.exp_log (by norm_num)]

/-- The replica weight of an `N`-channel area sector matches the per-channel replica traces
`(2^{1−n})^N` exactly when the sector holds `2^N` states. -/
theorem sector_replica_iff {hG : ℝ} (hG0 : hG ≠ 0) (N : ℕ) (n d : ℝ) :
    d * Real.exp (-n * areaN hG N / (4 * hG)) = Real.exp ((1 - n) * N * Real.log 2) ↔
      d = (2 : ℝ) ^ N := by
  rw [full_turn_weight hG0, two_pow_eq_exp,
    show (1 - n) * N * Real.log 2 = N * Real.log 2 + -n * N * Real.log 2 by ring, Real.exp_add]
  exact mul_left_inj' (Real.exp_pos _).ne'

/-- A saturated level contributes exactly one to the corner trace `Tr e^{−𝒜/(4Għ)}`. -/
theorem level_contributes_one {hG : ℝ} (hG0 : hG ≠ 0) (N : ℕ) :
    (2 : ℝ) ^ N * Real.exp (-areaN hG N / (4 * hG)) = 1 := by
  have h := full_turn_weight hG0 N 1
  rw [show -1 * areaN hG N / (4 * hG) = -areaN hG N / (4 * hG) by ring] at h
  rw [h, two_pow_eq_exp, ← Real.exp_add, show (N : ℝ) * Real.log 2 + -1 * N * Real.log 2 = 0 by ring,
    Real.exp_zero]

end Entropic.Extensions20261126.CornerBoost
