import Entropic.Pass2.Intertwiner
import Entropic.Pass2.LieTensor

/-! Second pass, chunk 19: C14-50, C09-34, C03-19 (complex form). In the H_mark coordinates of Q given by the
intertwiner 𝓘 (`Pass2.Intertwiner`), the compressions A_R = 𝓛 (I ⊗ H) 𝓘 and A_L = 𝓛 (H ⊗ I) 𝓘 (scaled by 720 to
integers) are nonzero and traceless, so by `LieTensor.gen_eq_sl` the complex Lie algebra generated by
𝔰𝔩(9) ⊗ I, I ⊗ 𝔰𝔩(9) and A_R ⊗ A_L is 𝔰𝔩(81). -/

namespace Entropic.Pass2.Bridge81
open Matrix Entropic.Pass2.Intertwiner
open scoped Kronecker

noncomputable section

/-- I ⊗ H and H ⊗ I on the product ladder basis (index 4a + b), H = diag(3, 1, −1, −3). -/
def IHF : Fin 16 → Fin 16 → ℤ := fun i j => if i = j then 3 - 2 * ((i.val % 4 : ℕ) : ℤ) else 0
def HIF : Fin 16 → Fin 16 → ℤ := fun i j => if i = j then 3 - 2 * ((i.val / 4 : ℕ) : ℤ) else 0

/-- 720 A_R and 720 A_L in H_mark coordinates. -/
def ARF : Fin 9 → Fin 9 → ℤ := mulL (mulL LF IHF) IF
def ALF : Fin 9 → Fin 9 → ℤ := mulL (mulL LF HIF) IF

theorem bridge_data :
    (List.ofFn fun i => ARF i i).sum = 0 ∧ ARF 0 0 = 1440 ∧ (List.ofFn fun i => ALF i i).sum = 0 ∧
      ALF 0 0 = 1440 := by
  decide +kernel

def AR : Matrix (Fin 9) (Fin 9) ℂ := cast ARF
def AL : Matrix (Fin 9) (Fin 9) ℂ := cast ALF

/-- AR = 720 · 𝓛 (I ⊗ H) 𝓘: the compression of I ⊗ H to Q in H_mark coordinates (𝓛 𝓘 = I₉, 𝓘 𝓛 = P_Q). -/
theorem AR_eq : AR = (720 : ℂ) • (Lc * cast IHF * Ic) := by
  rw [AR, ARF, Lc, Ic, ← cast_mul, ← cast_mul]
  simp only [Matrix.smul_mul, Matrix.mul_smul, smul_smul]
  norm_num

theorem AL_eq : AL = (720 : ℂ) • (Lc * cast HIF * Ic) := by
  rw [AL, ALF, Lc, Ic, ← cast_mul, ← cast_mul]
  simp only [Matrix.smul_mul, Matrix.mul_smul, smul_smul]
  norm_num

theorem trace_cast (F : Fin 9 → Fin 9 → ℤ) (h : (List.ofFn fun i => F i i).sum = 0) : (cast F).trace = 0 := by
  have : ((List.ofFn fun i => F i i).sum : ℂ) = 0 := by exact_mod_cast h
  rw [List.sum_ofFn] at this
  simpa [Matrix.trace] using this

/-- C14-50, C09-34, C03-19 (complex form): Lie(𝔰𝔩(9) ⊗ I, I ⊗ 𝔰𝔩(9), A_R ⊗ A_L) = 𝔰𝔩(81). -/
theorem bridge_generates (Z : Matrix (Fin 9 × Fin 9) (Fin 9 × Fin 9) ℂ) :
    Z ∈ LieTensor.gen AR AL ↔ Z.trace = 0 := by
  obtain ⟨h1, h2, h3, h4⟩ := bridge_data
  refine LieTensor.gen_eq_sl ?_ (trace_cast _ h1) ?_ (trace_cast _ h3) Z
  · intro h; have := congrFun (congrFun h 0) 0; simp [h2] at this
  · intro h; have := congrFun (congrFun h 0) 0; simp [h4] at this

end

end Entropic.Pass2.Bridge81
