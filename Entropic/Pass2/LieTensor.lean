import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Algebra.Lie.Classical
import Mathlib.LinearAlgebra.Matrix.Kronecker
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.Tactic

/-! Second pass, chunk 19: C14-43 (complex form). For finite index types of size ≥ 2 and nonzero traceless
A, B, the complex Lie algebra generated by 𝔰𝔩(m) ⊗ I, I ⊗ 𝔰𝔩(n) and A ⊗ B is 𝔰𝔩(mn).

* `ideal_all`: a subspace of 𝔤𝔩(m, ℂ) stable under ad of the traceless matrix units and containing a nonzero
  traceless A contains every traceless matrix (the elementary simplicity argument for 𝔰𝔩(m)).
* `tensor_generation`: the tensor-product generation lemma. -/

namespace Entropic.Pass2.LieTensor
open Matrix
open scoped Kronecker

attribute [local instance 100] LieRing.ofAssociativeRing

section Units
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Matrix unit E_ij. -/
noncomputable abbrev E (i j : ι) : Matrix ι ι ℂ := single i j 1

theorem E_apply (i j a b : ι) : E i j a b = if a = i ∧ b = j then 1 else 0 := by
  simp [E, single_apply, and_comm, eq_comm]

theorem mul_E (X : Matrix ι ι ℂ) (i j a b : ι) : (X * E i j) a b = if b = j then X a i else 0 := by
  rw [Matrix.mul_apply]
  by_cases hb : b = j
  · rw [if_pos hb, Finset.sum_eq_single i]
    · simp [E_apply, hb]
    · intro k _ hk; simp [E_apply, hk]
    · simp
  · rw [if_neg hb]; exact Finset.sum_eq_zero fun k _ => by simp [E_apply, hb]

theorem E_mul (X : Matrix ι ι ℂ) (i j a b : ι) : (E i j * X) a b = if a = i then X j b else 0 := by
  rw [Matrix.mul_apply]
  by_cases ha : a = i
  · rw [if_pos ha, Finset.sum_eq_single j]
    · simp [E_apply, ha]
    · intro k _ hk; simp [E_apply, hk]
    · simp
  · rw [if_neg ha]; exact Finset.sum_eq_zero fun k _ => by simp [E_apply, ha]

theorem EE (i j k l : ι) : E i j * E k l = if j = k then E i l else 0 := by
  ext a b
  rw [mul_E, E_apply]
  by_cases h : j = k
  · subst h; rw [if_pos rfl]; by_cases hb : b = l <;> simp [hb, E_apply]
  · rw [if_neg h]; by_cases hb : b = l <;> simp [hb, E_apply, Ne.symm h]

theorem bracket_units (i j k : ι) (hik : i ≠ k) : ⁅E i j, E j k⁆ = E i k := by
  rw [Ring.lie_def, EE, EE, if_pos rfl, if_neg (Ne.symm hik), sub_zero]

theorem bracket_diag (i j : ι) : ⁅E i j, E j i⁆ = E i i - E j j := by
  rw [Ring.lie_def, EE, EE, if_pos rfl, if_pos rfl]

theorem trace_E (i j : ι) : (E i j).trace = if i = j then 1 else 0 := by
  rw [Matrix.trace]
  by_cases h : i = j
  · subst h; rw [if_pos rfl, Finset.sum_eq_single i]
    · simp [E_apply]
    · intro k _ hk; simp [Matrix.diag, E_apply, hk]
    · simp
  · rw [if_neg h]; exact Finset.sum_eq_zero fun k _ => by
      simp only [Matrix.diag, E_apply]; split_ifs with hk
      · exact absurd (hk.1.symm.trans hk.2) h
      · rfl

/-- A traceless matrix is a combination of off-diagonal units and the differences E_aa − E_zz. -/
theorem traceless_decomp (z : ι) (X : Matrix ι ι ℂ) (hX : X.trace = 0) :
    X = ∑ a, ∑ b, (if a = b then X a a • (E a a - E z z) else X a b • E a b) := by
  have hsum : ∑ a, ∑ b, (if a = b then X a a • E z z else 0) = X.trace • E z z := by
    simp only [Finset.sum_ite_eq, Finset.mem_univ, if_true, Matrix.trace, Matrix.diag, Finset.sum_smul]
  conv_lhs => rw [matrix_eq_sum_single X]
  have : ∀ a b, (if a = b then X a a • (E a a - E z z) else X a b • E a b) =
      single a b (X a b) - (if a = b then X a a • E z z else 0) := by
    intro a b
    split_ifs with h
    · subst h; rw [smul_sub]; simp [E, smul_single]
    · simp [E, smul_single]
  simp only [this, Finset.sum_sub_distrib, hsum, hX, zero_smul, sub_zero]

/-- A subspace containing all off-diagonal units and all E_aa − E_bb contains every traceless matrix. -/
theorem traceless_of_units (S : Submodule ℂ (Matrix ι ι ℂ)) (hoff : ∀ a b, a ≠ b → E a b ∈ S)
    (hdiag : ∀ a b, E a a - E b b ∈ S) (X : Matrix ι ι ℂ) (hX : X.trace = 0) : X ∈ S := by
  by_cases hι : IsEmpty ι
  · have : X = 0 := by ext a; exact (hι.false a).elim
    rw [this]; exact S.zero_mem
  obtain ⟨z⟩ := not_isEmpty_iff.1 hι
  rw [traceless_decomp z X hX]
  refine S.sum_mem fun a _ => S.sum_mem fun b _ => ?_
  split_ifs with h
  · exact S.smul_mem _ (hdiag a z)
  · exact S.smul_mem _ (hoff a b h)

end Units

section Simple
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- ad-stable subspaces (under traceless units). -/
def AdStable (S : Submodule ℂ (Matrix ι ι ℂ)) : Prop :=
  (∀ X ∈ S, ∀ i j : ι, i ≠ j → ⁅E i j, X⁆ ∈ S) ∧ ∀ X ∈ S, ∀ i j : ι, ⁅E i i - E j j, X⁆ ∈ S

theorem ad_diff_apply (p q : ι) (X : Matrix ι ι ℂ) (a b : ι) :
    ⁅E p p - E q q, X⁆ a b = ((if a = p then 1 else 0) - (if a = q then 1 else 0) -
      ((if b = p then 1 else 0) - (if b = q then 1 else 0))) * X a b := by
  rw [Ring.lie_def, Matrix.sub_apply, Matrix.sub_mul, Matrix.mul_sub, Matrix.sub_apply, Matrix.sub_apply,
    E_mul, E_mul, mul_E, mul_E]
  split_ifs <;> simp_all <;> ring

/-- Extraction of one entry: from X ∈ S and p ≠ q, X_pq E_pq ∈ S. -/
theorem extract (S : Submodule ℂ (Matrix ι ι ℂ)) (hS : AdStable S) {X : Matrix ι ι ℂ} (hX : X ∈ S)
    {p q : ι} (hpq : p ≠ q) : X p q • E p q ∈ S := by
  set f : Matrix ι ι ℂ → Matrix ι ι ℂ := fun Y => ⁅E p p - E q q, Y⁆
  have hf : ∀ Y ∈ S, f Y ∈ S := fun Y hY => hS.2 Y hY p q
  have hd : ∀ (Y : Matrix ι ι ℂ) a b, f Y a b =
      ((if a = p then 1 else 0) - (if a = q then 1 else 0) - ((if b = p then 1 else 0) - (if b = q then 1 else 0))) *
        Y a b := fun Y a b => ad_diff_apply p q Y a b
  have key : X p q • E p q = (1 / 24 : ℂ) • (f (f (f (f X))) + (2 : ℂ) • f (f (f X)) - f (f X) - (2 : ℂ) • f X) := by
    ext a b
    simp only [Matrix.smul_apply, Matrix.add_apply, Matrix.sub_apply, hd, E_apply, smul_eq_mul]
    by_cases ha : a = p <;> by_cases hb : b = q <;> by_cases ha' : a = q <;> by_cases hb' : b = p <;>
      simp_all <;> ring
  rw [key]
  refine S.smul_mem _ (S.sub_mem (S.sub_mem (S.add_mem ?_ (S.smul_mem _ ?_)) ?_) (S.smul_mem _ ?_))
  · exact hf _ (hf _ (hf _ (hf _ hX)))
  · exact hf _ (hf _ (hf _ hX))
  · exact hf _ (hf _ hX)
  · exact hf _ hX

/-- Simplicity of 𝔰𝔩(ι): an ad-stable subspace containing a nonzero traceless A contains every traceless
matrix. -/
theorem ideal_all (S : Submodule ℂ (Matrix ι ι ℂ)) (hS : AdStable S) {A : Matrix ι ι ℂ} (hA : A ∈ S)
    (hA0 : A ≠ 0) (htr : A.trace = 0) (X : Matrix ι ι ℂ) (hX : X.trace = 0) : X ∈ S := by
  -- one off-diagonal unit
  obtain ⟨p, q, hpq, hEpq⟩ : ∃ p q, p ≠ q ∧ E p q ∈ S := by
    by_cases hoff : ∃ p q, p ≠ q ∧ A p q ≠ 0
    · obtain ⟨p, q, hpq, hne⟩ := hoff
      refine ⟨p, q, hpq, ?_⟩
      have := S.smul_mem (A p q)⁻¹ (extract S hS hA hpq)
      rwa [smul_smul, inv_mul_cancel₀ hne, one_smul] at this
    · push Not at hoff
      by_contra hno
      push Not at hno
      -- A is diagonal with all diagonal entries equal, hence zero
      have hconst : ∀ p q, A p p = A q q := by
        intro p q
        by_contra hne
        have hpq : p ≠ q := fun h => hne (h ▸ rfl)
        have hm := hS.1 A hA p q hpq
        have e : ⁅E p q, A⁆ = (A q q - A p p) • E p q := by
          rw [Ring.lie_def]; ext a b
          rw [Matrix.sub_apply, E_mul, mul_E, Matrix.smul_apply, E_apply, smul_eq_mul]
          by_cases ha : a = p <;> by_cases hb : b = q
          · subst ha; subst hb; simp
          · subst ha; simpa [hb] using hoff q b (fun h => hb h.symm)
          · subst hb; simpa [ha] using hoff a p ha
          · simp [ha, hb]
        rw [e] at hm
        have := S.smul_mem (A q q - A p p)⁻¹ hm
        rw [smul_smul, inv_mul_cancel₀ (sub_ne_zero.2 (Ne.symm hne)), one_smul] at this
        exact hno p q hpq this
      apply hA0
      obtain ⟨z⟩ : Nonempty ι := by
        by_contra h; apply hA0; ext a; exact (not_nonempty_iff.1 h |>.false a).elim
      have hcard : (Fintype.card ι : ℂ) * A z z = 0 := by
        rw [← htr, Matrix.trace]; simp [Matrix.diag, hconst _ z, Finset.sum_const, nsmul_eq_mul]
      have hz : A z z = 0 := (mul_eq_zero.1 hcard).resolve_left (by
        have : 0 < Fintype.card ι := Fintype.card_pos_iff.2 ⟨z⟩
        exact_mod_cast this.ne')
      ext a b
      by_cases hab : a = b
      · subst hab; rw [hconst a z, hz]; rfl
      · exact hoff a b hab
  -- all off-diagonal units
  have hD : E q q - E p p ∈ S := by
    have h1 := hS.1 _ hEpq q p (Ne.symm hpq); rwa [bracket_diag q p] at h1
  have hqp : E q p ∈ S := by
    have h2 := hS.1 _ hD q p (Ne.symm hpq)
    have e : ⁅E q p, E q q - E p p⁆ = (-2 : ℂ) • E q p := by
      rw [Ring.lie_def, Matrix.mul_sub, Matrix.sub_mul, EE, EE, EE, EE]
      simp only [↓reduceIte, if_neg hpq, if_neg (Ne.symm hpq)]; module
    rw [e] at h2
    have := S.smul_mem (-1 / 2 : ℂ) h2
    rwa [smul_smul, show (-1 / 2 : ℂ) * -2 = 1 by norm_num, one_smul] at this
  have hoff : ∀ r s, r ≠ s → E r s ∈ S := by
    intro r s hrs
    by_cases hrq : r = q
    · subst hrq
      by_cases hsp : s = p
      · subst hsp; exact hqp
      · have h3 := hS.1 _ hqp p s (Ne.symm hsp)
        have e : ⁅E p s, E r p⁆ = (-1 : ℂ) • E r s := by
          rw [Ring.lie_def, EE, EE]; simp only [↓reduceIte, if_neg (Ne.symm hrs)]; module
        rw [e] at h3
        have := S.smul_mem (-1 : ℂ) h3
        rwa [smul_smul, show (-1 : ℂ) * -1 = 1 by norm_num, one_smul] at this
    · have hErq : E r q ∈ S := by
        by_cases hrp : r = p
        · subst hrp; exact hEpq
        · have h4 := hS.1 _ hEpq r p hrp
          have e : ⁅E r p, E p q⁆ = E r q := by
            rw [Ring.lie_def, EE, EE]; simp only [↓reduceIte, if_neg (Ne.symm hrq)]; simp
          rwa [e] at h4
      by_cases hsq : s = q
      · subst hsq; exact hErq
      · have h5 := hS.1 _ hErq q s (Ne.symm hsq)
        have e : ⁅E q s, E r q⁆ = (-1 : ℂ) • E r s := by
          rw [Ring.lie_def, EE, EE]; simp only [↓reduceIte, if_neg (Ne.symm hrs)]; module
        rw [e] at h5
        have := S.smul_mem (-1 : ℂ) h5
        rwa [smul_smul, show (-1 : ℂ) * -1 = 1 by norm_num, one_smul] at this
  have hdiag : ∀ a b, E a a - E b b ∈ S := by
    intro a b
    by_cases hab : a = b
    · subst hab; simp
    · have := hS.1 _ (hoff b a (Ne.symm hab)) a b hab
      rwa [bracket_diag] at this
  exact traceless_of_units S hoff hdiag X hX

end Simple

section Tensor
variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

theorem sub_kron (A B : Matrix ι ι ℂ) (C : Matrix κ κ ℂ) : (A - B) ⊗ₖ C = A ⊗ₖ C - B ⊗ₖ C := by
  ext ⟨a, b⟩ ⟨c, d⟩; simp [Matrix.kroneckerMap_apply, sub_mul]

theorem kron_sub (A : Matrix ι ι ℂ) (B C : Matrix κ κ ℂ) : A ⊗ₖ (B - C) = A ⊗ₖ B - A ⊗ₖ C := by
  ext ⟨a, b⟩ ⟨c, d⟩; simp [Matrix.kroneckerMap_apply, mul_sub]

theorem lie_kron_left (X M : Matrix ι ι ℂ) (N : Matrix κ κ ℂ) :
    ⁅X ⊗ₖ (1 : Matrix κ κ ℂ), M ⊗ₖ N⁆ = ⁅X, M⁆ ⊗ₖ N := by
  rw [Ring.lie_def, Ring.lie_def, ← Matrix.mul_kronecker_mul, ← Matrix.mul_kronecker_mul, Matrix.one_mul,
    Matrix.mul_one, sub_kron]

theorem lie_kron_right (Y N : Matrix κ κ ℂ) (M : Matrix ι ι ℂ) :
    ⁅(1 : Matrix ι ι ℂ) ⊗ₖ Y, M ⊗ₖ N⁆ = M ⊗ₖ ⁅Y, N⁆ := by
  rw [Ring.lie_def, Ring.lie_def, ← Matrix.mul_kronecker_mul, ← Matrix.mul_kronecker_mul, Matrix.one_mul,
    Matrix.mul_one, kron_sub]

theorem kron_units (i j : ι) (k l : κ) : E i j ⊗ₖ E k l = E (i, k) (j, l) := by
  rw [E, E, E, Matrix.single_kronecker_single, mul_one]

theorem trace_unit_off {i j : ι} (h : i ≠ j) : (E i j).trace = 0 := by rw [trace_E, if_neg h]

theorem trace_unit_diff (i j : ι) : (E i i - E j j).trace = 0 := by
  rw [Matrix.trace_sub, trace_E, trace_E, if_pos rfl, if_pos rfl, sub_self]

/-- C14-43 (complex form): the Lie algebra generated by 𝔰𝔩(ι) ⊗ I, I ⊗ 𝔰𝔩(κ) and a product A ⊗ B of nonzero
traceless matrices contains every traceless matrix on ι × κ. -/
theorem tensor_generation (L : LieSubalgebra ℂ (Matrix (ι × κ) (ι × κ) ℂ))
    (h1 : ∀ X : Matrix ι ι ℂ, X.trace = 0 → X ⊗ₖ (1 : Matrix κ κ ℂ) ∈ L)
    (h2 : ∀ Y : Matrix κ κ ℂ, Y.trace = 0 → (1 : Matrix ι ι ℂ) ⊗ₖ Y ∈ L)
    {A : Matrix ι ι ℂ} {B : Matrix κ κ ℂ} (hAB : A ⊗ₖ B ∈ L) (hA0 : A ≠ 0) (hAt : A.trace = 0)
    (hB0 : B ≠ 0) (hBt : B.trace = 0) (Z : Matrix (ι × κ) (ι × κ) ℂ) (hZ : Z.trace = 0) : Z ∈ L := by
  -- S1 = {M | M ⊗ B ∈ L}
  let S1 : Submodule ℂ (Matrix ι ι ℂ) :=
    { carrier := {M | M ⊗ₖ B ∈ L}
      add_mem' := fun {M M'} hM hM' => by
        show (M + M') ⊗ₖ B ∈ L; rw [Matrix.add_kronecker]; exact L.add_mem hM hM'
      zero_mem' := by show (0 : Matrix ι ι ℂ) ⊗ₖ B ∈ L; rw [Matrix.zero_kronecker]; exact L.zero_mem
      smul_mem' := fun c {M} hM => by
        show (c • M) ⊗ₖ B ∈ L; rw [Matrix.smul_kronecker]; exact L.smul_mem c hM }
  have hS1 : AdStable S1 := by
    constructor
    · intro X hX i j hij
      show ⁅E i j, X⁆ ⊗ₖ B ∈ L
      rw [← lie_kron_left]; exact L.lie_mem (h1 _ (trace_unit_off hij)) hX
    · intro X hX i j
      show ⁅E i i - E j j, X⁆ ⊗ₖ B ∈ L
      rw [← lie_kron_left]; exact L.lie_mem (h1 _ (trace_unit_diff i j)) hX
  have hMB : ∀ M : Matrix ι ι ℂ, M.trace = 0 → M ⊗ₖ B ∈ L := fun M hM =>
    ideal_all S1 hS1 (A := A) hAB hA0 hAt M hM
  -- S2 = {N | ∀ M traceless, M ⊗ N ∈ L}
  let S2 : Submodule ℂ (Matrix κ κ ℂ) :=
    { carrier := {N | ∀ M : Matrix ι ι ℂ, M.trace = 0 → M ⊗ₖ N ∈ L}
      add_mem' := fun {N N'} hN hN' M hM => by
        rw [Matrix.kronecker_add]; exact L.add_mem (hN M hM) (hN' M hM)
      zero_mem' := fun M _ => by rw [Matrix.kronecker_zero]; exact L.zero_mem
      smul_mem' := fun c {N} hN M hM => by rw [Matrix.kronecker_smul]; exact L.smul_mem c (hN M hM) }
  have hS2 : AdStable S2 := by
    constructor
    · intro N hN k l hkl M hM
      rw [← lie_kron_right]; exact L.lie_mem (h2 _ (trace_unit_off hkl)) (hN M hM)
    · intro N hN k l M hM
      rw [← lie_kron_right]; exact L.lie_mem (h2 _ (trace_unit_diff k l)) (hN M hM)
  have hMN : ∀ N : Matrix κ κ ℂ, N.trace = 0 → ∀ M : Matrix ι ι ℂ, M.trace = 0 → M ⊗ₖ N ∈ L := fun N hN =>
    ideal_all S2 hS2 (A := B) hMB hB0 hBt N hN
  -- off-diagonal units of ι × κ
  have hne : Nonempty ι := by
    by_contra h; apply hA0; ext a; exact (not_nonempty_iff.1 h |>.false a).elim
  have hcard : (Fintype.card ι : ℂ) ≠ 0 := by
    have : 0 < Fintype.card ι := Fintype.card_pos_iff.2 hne
    exact_mod_cast this.ne'
  set c : ℂ := (Fintype.card ι : ℂ)⁻¹
  have hdtr : ∀ i : ι, (E i i - c • (1 : Matrix ι ι ℂ)).trace = 0 := by
    intro i
    rw [Matrix.trace_sub, Matrix.trace_smul, Matrix.trace_one, trace_E, if_pos rfl, smul_eq_mul,
      inv_mul_cancel₀ hcard, sub_self]
  have hneκ : Nonempty κ := by
    by_contra h; apply hB0; ext a; exact (not_nonempty_iff.1 h |>.false a).elim
  have hcardκ : (Fintype.card κ : ℂ) ≠ 0 := by
    have : 0 < Fintype.card κ := Fintype.card_pos_iff.2 hneκ
    exact_mod_cast this.ne'
  set c' : ℂ := (Fintype.card κ : ℂ)⁻¹
  have hdtr' : ∀ k : κ, (E k k - c' • (1 : Matrix κ κ ℂ)).trace = 0 := by
    intro k
    rw [Matrix.trace_sub, Matrix.trace_smul, Matrix.trace_one, trace_E, if_pos rfl, smul_eq_mul,
      inv_mul_cancel₀ hcardκ, sub_self]
  have hoff : ∀ a b : ι × κ, a ≠ b → E a b ∈ L := by
    rintro ⟨i, k⟩ ⟨j, l⟩ hab
    rw [← kron_units]
    by_cases hij : i = j
    · subst hij
      have hkl : k ≠ l := fun h => hab (by rw [h])
      have e : E i i ⊗ₖ E k l = (E i i - c • (1 : Matrix ι ι ℂ)) ⊗ₖ E k l + c • ((1 : Matrix ι ι ℂ) ⊗ₖ E k l) := by
        rw [sub_kron, Matrix.smul_kronecker]; abel
      rw [e]
      exact L.add_mem (hMN _ (trace_unit_off hkl) _ (hdtr i)) (L.smul_mem c (h2 _ (trace_unit_off hkl)))
    · by_cases hkl : k = l
      · subst hkl
        have e : E i j ⊗ₖ E k k = E i j ⊗ₖ (E k k - c' • (1 : Matrix κ κ ℂ)) + c' • (E i j ⊗ₖ (1 : Matrix κ κ ℂ)) := by
          rw [kron_sub, Matrix.kronecker_smul]; abel
        rw [e]
        exact L.add_mem (hMN _ (hdtr' k) _ (trace_unit_off hij)) (L.smul_mem c' (h1 _ (trace_unit_off hij)))
      · exact hMN _ (trace_unit_off hkl) _ (trace_unit_off hij)
  have hdiag : ∀ a b : ι × κ, E a a - E b b ∈ L := by
    intro a b
    by_cases hab : a = b
    · subst hab; simp
    · rw [← bracket_diag]; exact L.lie_mem (hoff a b hab) (hoff b a (Ne.symm hab))
  exact traceless_of_units L.toSubmodule hoff hdiag Z hZ

end Tensor

section Corollaries

/-- The generated Lie algebra, as a Lie span. -/
def gen {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] (A : Matrix ι ι ℂ)
    (B : Matrix κ κ ℂ) : LieSubalgebra ℂ (Matrix (ι × κ) (ι × κ) ℂ) :=
  LieSubalgebra.lieSpan ℂ _ ({Z | ∃ X : Matrix ι ι ℂ, X.trace = 0 ∧ Z = X ⊗ₖ (1 : Matrix κ κ ℂ)} ∪
    {Z | ∃ Y : Matrix κ κ ℂ, Y.trace = 0 ∧ Z = (1 : Matrix ι ι ℂ) ⊗ₖ Y} ∪ {A ⊗ₖ B})

/-- C14-43: Lie(𝔰𝔩(m) ⊗ I, I ⊗ 𝔰𝔩(n), A ⊗ B) = 𝔰𝔩(mn) for nonzero traceless A, B. -/
theorem gen_eq_sl {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
    {A : Matrix ι ι ℂ} {B : Matrix κ κ ℂ} (hA0 : A ≠ 0) (hAt : A.trace = 0) (hB0 : B ≠ 0) (hBt : B.trace = 0)
    (Z : Matrix (ι × κ) (ι × κ) ℂ) : Z ∈ gen A B ↔ Z.trace = 0 := by
  constructor
  · intro hZ
    have hle : gen A B ≤ LieAlgebra.SpecialLinear.sl (ι × κ) ℂ := by
      refine LieSubalgebra.lieSpan_le.2 ?_
      rintro W ((⟨X, hX, rfl⟩ | ⟨Y, hY, rfl⟩) | hW)
      · show Matrix.traceLinearMap _ ℂ ℂ _ = 0
        simp [Matrix.trace_kronecker, hX]
      · show Matrix.traceLinearMap _ ℂ ℂ _ = 0
        simp [Matrix.trace_kronecker, hY]
      · rw [Set.mem_singleton_iff] at hW; subst hW
        show Matrix.traceLinearMap _ ℂ ℂ _ = 0
        simp [Matrix.trace_kronecker, hAt]
    exact hle hZ
  · intro hZ
    refine tensor_generation (gen A B) (fun X hX => LieSubalgebra.subset_lieSpan (Or.inl (Or.inl ⟨X, hX, rfl⟩)))
      (fun Y hY => LieSubalgebra.subset_lieSpan (Or.inl (Or.inr ⟨Y, hY, rfl⟩)))
      (LieSubalgebra.subset_lieSpan (Or.inr rfl)) hA0 hAt hB0 hBt Z hZ

/-- J_z of spin 3/2 (doubled): H = diag(3, 1, −1, −3). -/
def H4 : Matrix (Fin 4) (Fin 4) ℂ := Matrix.diagonal ![3, 1, -1, -3]

/-- C14-44: Lie(𝔰𝔩(16)₁₂, 𝔰𝔩(4)₃, H₂ ⊗ H₃) = 𝔰𝔩(64) (dimension 64² − 1 = 4095): every traceless matrix on
(slots 1, 2) × slot 3 lies in the generated algebra, and conversely. -/
theorem three_slot (Z : Matrix ((Fin 4 × Fin 4) × Fin 4) ((Fin 4 × Fin 4) × Fin 4) ℂ) :
    Z ∈ gen ((1 : Matrix (Fin 4) (Fin 4) ℂ) ⊗ₖ H4) H4 ↔ Z.trace = 0 := by
  have hH0 : H4 ≠ 0 := by
    intro h; have := congrFun (congrFun h 0) 0; simp [H4] at this
  have hHt : H4.trace = 0 := by simp [H4, Matrix.trace, Fin.sum_univ_four] <;> norm_num
  refine gen_eq_sl ?_ ?_ hH0 hHt Z
  · intro h; have := congrFun (congrFun h (0, 0)) (0, 0); simp [H4, Matrix.kroneckerMap_apply] at this
  · rw [Matrix.trace_kronecker, hHt, mul_zero]

end Corollaries

end Entropic.Pass2.LieTensor
