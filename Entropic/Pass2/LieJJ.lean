/-- C14-34 (complex form): the Lie algebra generated by the nine X ⊗ Y is 𝔰𝔩(16, ℂ). -/
theorem generates_sl16 (X : Matrix (Fin 16) (Fin 16) ℂ) (hX : X.trace = 0) : X ∈ L := by
  refine traceless_mem L (by norm_num) (fun i h => ?_) (fun i h => ?_) X hX

  · have hi : i < 15 := by omega
    interval_cases i
    · exact memT_0_1
    · exact memT_1_2
    · exact memT_2_3
    · exact memT_3_4
    · exact memT_4_5
    · exact memT_5_6
    · exact memT_6_7
    · exact memT_7_8
    · exact memT_8_9
    · exact memT_9_10
    · exact memT_10_11
    · exact memT_11_12
    · exact memT_12_13
    · exact memT_13_14
    · exact memT_14_15
  · have hi : i < 15 := by omega
    interval_cases i
    · exact memT_1_0
    · exact memT_2_1
    · exact memT_3_2
    · exact memT_4_3
    · exact memT_5_4
    · exact memT_6_5
