def mulL (A B : Fin 16 → Fin 16 → ℤ) : Fin 16 → Fin 16 → ℤ :=
  fun i j => (List.ofFn fun l => A i l * B l j).sum

def brF (A B : Fin 16 → Fin 16 → ℤ) : Fin 16 → Fin 16 → ℤ := fun i j => mulL A B i j - mulL B A i j

abbrev cast (A : Fin 16 → Fin 16 → ℤ) : Matrix (Fin 16) (Fin 16) ℂ := (Matrix.of A).map (Int.castRingHom ℂ)

theorem of_mul (A B : Fin 16 → Fin 16 → ℤ) : Matrix.of A * Matrix.of B = Matrix.of (mulL A B) := by
  ext i j; simp [Matrix.mul_apply, mulL, Fin.sum_univ_succ]

theorem cast_mul (A B : Fin 16 → Fin 16 → ℤ) : cast A * cast B = cast (mulL A B) := by
  rw [cast, cast, ← Matrix.map_mul, of_mul]

theorem cast_add (A B : Fin 16 → Fin 16 → ℤ) : cast (fun i j => A i j + B i j) = cast A + cast B := by
  ext i j; simp

theorem cast_smul (a : ℤ) (A : Fin 16 → Fin 16 → ℤ) : cast (fun i j => a * A i j) = (a : ℂ) • cast A := by
  ext i j; simp

theorem castD (D : ℤ) (r c : Fin 16) :
    cast (fun i j => D * (if i = r ∧ j = c then 1 else 0)) = (D : ℂ) • single r c (1 : ℂ) := by
  ext i j; by_cases h : i = r ∧ j = c
  · obtain ⟨rfl, rfl⟩ := h; simp
  · simp only [Matrix.map_apply, Matrix.of_apply, Matrix.smul_apply, Matrix.single_apply, if_neg h]
    simp only [show ¬(r = i ∧ c = j) from fun e => h ⟨e.1.symm, e.2.symm⟩, if_false]; simp

theorem cast_br (A B : Fin 16 → Fin 16 → ℤ) : ⁅cast A, cast B⁆ = cast (brF A B) := by
  rw [Ring.lie_def, cast_mul, cast_mul]; ext i j; simp [brF]

theorem cast_ext (A B : Fin 16 → Fin 16 → ℤ) (h : ∀ i j, A i j = B i j) : cast A = cast B := by
  ext i j; simp [h i j]

