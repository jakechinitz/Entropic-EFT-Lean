/-- The generators are traceless, so L ⊆ 𝔰𝔩(16, ℂ): L consists exactly of the traceless matrices. -/
theorem L_eq_traceless (X : Matrix (Fin 16) (Fin 16) ℂ) : X ∈ L ↔ X.trace = 0 := by
  constructor
  · intro hX
    have hle : L ≤ LieAlgebra.SpecialLinear.sl (Fin 16) ℂ := by
      refine LieSubalgebra.lieSpan_le.2 ?_
      intro Y hY
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hY
      show Matrix.traceLinearMap (Fin 16) ℂ ℂ Y = 0
      rcases hY with h | h | h | h | h | h | h | h | h <;> subst h <;>
        simp [Matrix.trace, Fin.sum_univ_succ, G0F, G1F, G2F, G3F, G4F, G5F, G6F, G7F, G8F]
    have := hle hX
    exact this
  · exact generates_sl16 X

end

